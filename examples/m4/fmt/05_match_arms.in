type Shape =
  | Circle(radius: Float)
  | Rect(w: Float, h: Float)
  | Dot

fn area(s: Shape) -> Float {
  match s {
    Circle(r) -> 3.0 * r * r
    Rect(w, h)    -> w * h
    Dot ->   0.0
  }
}
let n = 2
let word = match n {
  0 -> "none"
  1 -> "one"
  _ -> {
    let s = "many"
    s
  }
  }
print("{area(Rect(2.0, 3.0))} {word}")
