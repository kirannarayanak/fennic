            "value": "```fennic\nn: Int\n```"
          },
          "range": {
            "start": {
              "line": 10,
              "character": 11
            },
            "end": {
              "line": 10,
              "character": 12
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 13,
            "character": 7
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 7,
        "result": {
          "contents": {
            "kind": "markdown",
            "value": "```fennic\nfn len(List[Int]) -> Int\n```"
          },
          "range": {
            "start": {
              "line": 13,
              "character": 6
            },
            "end": {
              "line": 13,
              "character": 9
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 9,
            "character": 1
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 8,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 7,
            "character": 26
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 9,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 3,
            "character": 1
          }
        }
