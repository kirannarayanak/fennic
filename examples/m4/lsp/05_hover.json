{
  "about": "hover shows a name's type or a function's signature, and nothing on keywords, literals or space",
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "processId": null,
          "rootUri": null,
          "capabilities": {}
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "capabilities": {
            "positionEncoding": "utf-16",
            "textDocumentSync": 1,
            "documentFormattingProvider": true,
            "hoverProvider": true,
            "definitionProvider": true
          },
          "serverInfo": {
            "name": "fennic"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "initialized",
        "params": {}
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "textDocument/didOpen",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn",
            "languageId": "fennic",
            "version": 1,
            "text": "type User {\n  name: Str\n  age: Int\n}\nfn greet(who: Str) -> Str {\n  \"Hello, {who}\"\n}\nlet ada = User { name: \"Ada\", age: 41 }\nvar count = 0\nfor n in [1, 2] {\n  count += n\n}\nprint(greet(ada.name))\nprint(len([count]))\n"
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "method": "textDocument/publishDiagnostics",
        "params": {
          "uri": "file:///work/main.fn",
          "version": 1,
          "diagnostics": []
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 8,
            "character": 5
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "contents": {
            "kind": "markdown",
            "value": "```fennic\ncount: Int\n```"
          },
          "range": {
            "start": {
              "line": 8,
              "character": 4
            },
            "end": {
              "line": 8,
              "character": 9
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 12,
            "character": 7
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "contents": {
            "kind": "markdown",
            "value": "```fennic\nfn greet(who: Str) -> Str\n```"
          },
          "range": {
            "start": {
              "line": 12,
              "character": 6
            },
            "end": {
              "line": 12,
              "character": 11
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 12,
            "character": 17
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "contents": {
            "kind": "markdown",
            "value": "```fennic\nname: Str\n```"
          },
          "range": {
            "start": {
              "line": 12,
              "character": 16
            },
            "end": {
              "line": 12,
              "character": 20
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 7,
            "character": 5
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 5,
        "result": {
          "contents": {
            "kind": "markdown",
            "value": "```fennic\nada: User\n```"
          },
          "range": {
            "start": {
              "line": 7,
              "character": 4
            },
            "end": {
              "line": 7,
              "character": 7
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 10,
            "character": 11
          }
        }
      }
    },
    {
      "expect": {
