    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 11,
        "method": "shutdown"
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 11,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "exit"
      }
    },
    {
      "exit": 0
    }
  ]
}
