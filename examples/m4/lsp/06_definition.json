{
  "about": "definition goes to where a name, function, field or type is declared, and to nothing for a built-in",
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "processId": null,
          "rootUri": null,
          "capabilities": {}
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "capabilities": {
            "positionEncoding": "utf-16",
            "textDocumentSync": 1,
            "documentFormattingProvider": true,
            "hoverProvider": true,
            "definitionProvider": true
          },
          "serverInfo": {
            "name": "fennic"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "initialized",
        "params": {}
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "textDocument/didOpen",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn",
            "languageId": "fennic",
            "version": 1,
            "text": "type User {\n  name: Str\n  age: Int\n}\nfn greet(who: Str) -> Str {\n  \"Hello, {who}\"\n}\nlet ada = User { name: \"Ada\", age: 41 }\nvar count = 0\nfor n in [1, 2] {\n  count += n\n}\nprint(greet(ada.name))\nprint(len([count]))\n"
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "method": "textDocument/publishDiagnostics",
        "params": {
          "uri": "file:///work/main.fn",
          "version": 1,
          "diagnostics": []
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "textDocument/definition",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 10,
            "character": 3
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "uri": "file:///work/main.fn",
          "range": {
            "start": {
              "line": 8,
              "character": 4
            },
            "end": {
              "line": 8,
              "character": 9
            }
          }
        }
      }
    },
    {
