{
  "about": "initialize advertises the four features; shutdown and exit end the server with status 0",
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "processId": null,
          "rootUri": null,
          "capabilities": {}
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "capabilities": {
            "positionEncoding": "utf-16",
            "textDocumentSync": 1,
            "documentFormattingProvider": true,
            "hoverProvider": true,
            "definitionProvider": true
          },
          "serverInfo": {
            "name": "fennic"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "initialized",
        "params": {}
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "textDocument/completion",
        "params": {
          "textDocument": {
            "uri": "file:///work/main.fn"
          },
          "position": {
            "line": 0,
            "character": 0
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "error": {
          "code": -32601,
          "message": "method not found: textDocument/completion"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "$/setTrace",
        "params": {
          "value": "off"
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "shutdown"
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "exit"
      }
    },
    {
      "exit": 0
    }
  ]
}
