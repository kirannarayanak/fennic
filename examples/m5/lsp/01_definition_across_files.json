{
  "about": "hover and definition reach into an imported file; a module's name goes to its file",
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "processId": null,
          "rootUri": "{root}",
          "capabilities": {}
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "capabilities": {
            "positionEncoding": "utf-16",
            "textDocumentSync": 1,
            "documentFormattingProvider": true,
            "hoverProvider": true,
            "definitionProvider": true
          },
          "serverInfo": {
            "name": "fennic"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "initialized",
        "params": {}
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "textDocument/didOpen",
        "params": {
          "textDocument": {
            "uri": "{root}/main.fn",
            "languageId": "fennic",
            "version": 1,
            "text": "import \"lib/report\"\n\nprint(report.line(\"figs\", 305))\n"
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "method": "textDocument/publishDiagnostics",
        "params": {
          "uri": "{root}/main.fn",
          "version": 1,
          "diagnostics": []
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "{root}/main.fn"
          },
          "position": {
            "line": 2,
            "character": 14
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "contents": {
            "kind": "markdown",
            "value": "```fennic\nfn line(name: Str, cents: Int) -> Str\n```"
          },
          "range": {
            "start": {
              "line": 2,
              "character": 13
            },
            "end": {
              "line": 2,
              "character": 17
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "textDocument/definition",
        "params": {
          "textDocument": {
            "uri": "{root}/main.fn"
          },
          "position": {
            "line": 2,
            "character": 14
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "uri": "{root}/lib/report.fn",
          "range": {
            "start": {
              "line": 3,
              "character": 3
            },
            "end": {
              "line": 3,
              "character": 7
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "textDocument/hover",
        "params": {
          "textDocument": {
            "uri": "{root}/main.fn"
          },
          "position": {
            "line": 2,
            "character": 8
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "contents": {
            "kind": "markdown",
            "value": "```fennic\nimport \"lib/report\"\n```"
          },
          "range": {
            "start": {
              "line": 2,
              "character": 6
            },
            "end": {
              "line": 2,
              "character": 12
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "textDocument/definition",
        "params": {
          "textDocument": {
            "uri": "{root}/main.fn"
          },
          "position": {
            "line": 2,
            "character": 8
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 5,
        "result": {
          "uri": "{root}/lib/report.fn",
          "range": {
            "start": {
              "line": 0,
              "character": 0
            },
            "end": {
              "line": 0,
              "character": 0
            }
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "shutdown"
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 6,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "exit"
      }
    },
    {
      "exit": 0
    }
  ]
}
