{
  "about": "an imported file with problems gets one diagnostic on its import line; a missing file gets the message fennic run prints",
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "processId": null,
          "rootUri": "{root}",
          "capabilities": {}
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "capabilities": {
            "positionEncoding": "utf-16",
            "textDocumentSync": 1,
            "documentFormattingProvider": true,
            "hoverProvider": true,
            "definitionProvider": true
          },
          "serverInfo": {
            "name": "fennic"
          }
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "initialized",
        "params": {}
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "textDocument/didOpen",
        "params": {
          "textDocument": {
            "uri": "{root}/uses_broken.fn",
            "languageId": "fennic",
            "version": 1,
            "text": "import \"broken\"\n\nprint(broken.half(4))\n"
          }
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "method": "textDocument/publishDiagnostics",
        "params": {
          "uri": "{root}/uses_broken.fn",
          "version": 1,
          "diagnostics": [
            {
              "range": {
                "start": {
                  "line": 0,
                  "character": 7
                },
                "end": {
                  "line": 0,
                  "character": 15
                }
              },
              "severity": 1,
              "source": "fennic",
              "message": "`broken.fn` has 1 problem\n\nhelp: open `broken.fn` to see it"
            }
          ]
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "textDocument/didChange",
        "params": {
          "textDocument": {
            "uri": "{root}/uses_broken.fn",
            "version": 2
          },
          "contentChanges": [
            {
              "text": "import \"nothere\"\n\nprint(nothere.half(4))\n"
            }
          ]
        }
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "method": "textDocument/publishDiagnostics",
        "params": {
          "uri": "{root}/uses_broken.fn",
          "version": 2,
          "diagnostics": [
            {
              "range": {
                "start": {
                  "line": 0,
                  "character": 7
                },
                "end": {
                  "line": 0,
                  "character": 16
                }
              },
              "severity": 1,
              "source": "fennic",
              "message": "there is no file `nothere.fn` to import\n\nhelp: the path is relative to this file's directory; create `nothere.fn` there, or correct the path"
            }
          ]
        }
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "shutdown"
      }
    },
    {
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": null
      }
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "method": "exit"
      }
    },
    {
      "exit": 0
    }
  ]
}
