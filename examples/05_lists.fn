// List literals. first and last return an option, because the list may be empty.
let primes = [2, 3, 5, 7, 11]
print("primes: {primes}")
print("count: {len(primes)}")
print("first: {first(primes) ?? 0}")
print("last: {last(primes) ?? 0}")
print("sum: {sum(primes)}")

let doubled = primes |> map(p -> p * 2)
print("doubled: {doubled}")

let nothing = []
print("first of empty: {first(nothing) ?? -1}")

let words = [
  "fennic",
  "is",
  "brisk",
]
print("words: {words}")
