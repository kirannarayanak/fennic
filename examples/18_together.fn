// together scopes the tasks it spawns and returns its last expression as T!.
// Results keep input order. If one task fails, the others are cancelled.
let files = ["data/a.txt", "data/b.txt", "data/c.txt"]

let pages = together {              // scopes its spawns, returns its last expression
  files |> map_par(f -> fs.read(f)!)
}!

print("read {len(pages)} files")
pages |> each(p -> print(p))

let squares = together { [1, 2, 3, 4] |> map_par(n -> n * n) }!
print("squares: {squares}")

let attempt = together {
  ["data/a.txt", "data/missing.txt"] |> map_par(f -> fs.read(f)!)
} or err -> { print("together failed: {err}"); [] }
print("got {len(attempt)} pages")
