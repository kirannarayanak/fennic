// Connector config audit: read every Kafka Connect connector JSON file in a
// folder and report the ones that break the naming, file, topic and
// snapshot rules. Exits with 1 if there are any, so CI fails.
//
//   fennic run audit.fn connectors
//
// Rules:
//   name      <system>-<entity>-<kind>: three lowercase words joined by
//             hyphens, the kind being cdc for a source connector and sink
//             for a sink
//   file      the file is named after the connector: <name>.json
//   prefix    a source connector's topic.prefix is <env>.<entity>, where
//             env is prod, staging or dev and entity is the name's middle
//             word
//   snapshot  a source connector sets snapshot.mode to initial or no_data

// The config's keys contain dots, so it is read as a map of strings.
type Connector {
  name: Str
  config: Map[Str, Str]
}

type Violation {
  file: Str
  rule: Str
  detail: Str
}

type Kind =
  | Source
  | Sink
  | Unknown

let envs = ["prod", "staging", "dev"]
let snapshot_modes = ["initial", "no_data"]

// Whether a list holds a value. The language has `contains` for text only.
fn member(xs: List[Str], x: Str) -> Bool {
  first(xs, y -> y == x) != none
}

fn kind(class: Str) -> Kind {
  if contains(class, ".debezium.") {
    Source
  } else if contains(class, "SinkConnector") {
    Sink
  } else {
    Unknown
  }
}

fn check(file: Str, c: Connector) -> List[Violation] {
  var found = []
  let parts = split(c.name, "-")
  let class = c.config["connector.class"] ?? ""
  let lowercase_words = (parts |> filter(p -> p == "" or lower(p) != p)).len() == 0
  let well_named = parts.len() == 3 and lowercase_words

  if not well_named {
    found.push(Violation { file: file, rule: "name", detail: "`{c.name}` is not <system>-<entity>-<kind> in lowercase" })
  }
  if last(split(file, "/")) != "{c.name}.json" {
    found.push(Violation { file: file, rule: "file", detail: "should be named {c.name}.json" })
  }
  match kind(class) {
    Unknown -> found.push(Violation { file: file, rule: "class", detail: "not a known source or sink connector: {class}" })
    Source -> {
      if last(parts) != "cdc" {
        found.push(Violation { file: file, rule: "name", detail: "a source connector's name ends in -cdc" })
      }
      // The prefix rule names the entity, so it needs a well-formed name.
      if well_named {
        let entity = parts[1] ?? ""
        let prefix = c.config["topic.prefix"] ?? ""
        let env = split(prefix, ".")[0] ?? ""
        if not member(envs, env) or prefix != "{env}.{entity}" {
          found.push(Violation { file: file, rule: "prefix", detail: "topic.prefix `{prefix}` should be <env>.{entity}, env one of {join(envs, ", ")}" })
        }
      }
      let mode = c.config["snapshot.mode"] ?? "(not set)"
      if not member(snapshot_modes, mode) {
        found.push(Violation { file: file, rule: "snapshot", detail: "snapshot.mode {mode} is not one of {join(snapshot_modes, ", ")}" })
      }
    }
    Sink -> {
      if last(parts) != "sink" {
        found.push(Violation { file: file, rule: "name", detail: "a sink connector's name ends in -sink" })
      }
    }
  }
  found
}

fn parse(text: Str) -> Connector! {
  json.parse(text)
}

fn check_file(file: Str) -> List[Violation]! {
  let c = parse(fs.read(file)!)!
  check(file, c)
}

// A file that cannot be read or parsed is itself a violation.
fn audit(file: Str) -> List[Violation] {
  check_file(file) else err -> [Violation { file: file, rule: "json", detail: "{err}" }]
}

fn main(args: List[Str]) -> Int {
  let dir = args[0] ?? "connectors"
  let files = fs.list(dir, "*.json")!
  let violations = files |> map(f -> audit(f)) |> flatten()
  violations |> each(v -> print("{pad_end(last(split(v.file, "/")) ?? v.file, 20)}{pad_end(v.rule, 10)}{v.detail}"))
  print("{files.len()} connectors, {violations.len()} violations")
  if violations.len() > 0 { 1 } else { 0 }
}
